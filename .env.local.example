# Copy this file to .env.local and fill in what you need. .env.local is
# gitignored and is re-read on every request, so pasting a key in never needs a
# restart. A shell variable of the same name always wins over this file.

# Optional. Leave it unset and the UI will register an account and mint the
# bootstrap key for you on the first click. Set it to reuse an account you
# already have — the raw key is only ever shown once, at mint time.
PAYRIT_API_KEY=

# The deployment to talk to. Defaults to the Production server in the
# OpenAPI spec at https://payrit-ble.mintlify.site/api-reference/openapi.yaml
# PAYRIT_API_BASE=https://payrit-ble-backend.vercel.app

# Bundle id the simulated iOS App Attest statement claims.
# PAYRIT_APP_ID=com.payrit.harness

# PORT=4546

# Only set this if you deliberately want to drive the API with a pk_live_ key.
# PAYRIT_ALLOW_LIVE=yes

# --- Live enrollment: test attestation roots ---
# These default to the files in .harness-pki/, so set them only if they live
# elsewhere. Without them the live path fails closed with a 422, as documented.

# PAYRIT_APPATTEST_ROOT_CERT=.harness-pki/appattest-root.pem
# PAYRIT_APPATTEST_ROOT_JWK=.harness-pki/appattest-root.jwk
# PAYRIT_TEAM_ID=TEAMID1234
# PAYRIT_BUNDLE_ID=com.payrit.test

# PAYRIT_ANDROID_ROOT_CERT=.harness-pki/android-root.pem
# PAYRIT_ANDROID_ROOT_JWK=.harness-pki/android-root.jwk
# ANDROID_APP_PACKAGE=com.payrit.test
# ANDROID_SIGNING_CERT_DIGEST=<64 hex chars>

# How the attestation challenge is built, and where the app id is read from.
# PAYRIT_ANDROID_BINDING=raw
# PAYRIT_ANDROID_APPID_LOCATION=tee
